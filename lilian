/* ============ Interactions fiche produit ============ */
function initProduit(){
  const etat = {v:"Très bon état"}, capacite = {v:"128 Go"}, batterie = {on:false};

  const calc = () => {
    let p = PRIX_BASE.etat[etat.v] + PRIX_BASE.capacite[capacite.v] + 379;
    if(batterie.on) p += 39;
    document.getElementById("p-total").textContent = p + " €";
    document.getElementById("p-economie").textContent = "Vous économisez " + (PRIX_NEUF - p) + " €";
    document.getElementById("p-4x").textContent = "Payez en 4x sans frais : 4 × " + (p/4).toFixed(2).replace(".",",") + " €";
    document.getElementById("batt-prix").textContent = batterie.on ? "Incluse" : "+39 €";
  };

  const brancher = (idSel, cible) => {
    const zone = document.getElementById(idSel);
    zone.addEventListener("click", e => {
      const b = e.target.closest(".pastille"); if(!b) return;
      zone.querySelectorAll(".pastille").forEach(x=>x.classList.remove("active"));
      b.classList.add("active");
      cible.v = b.dataset.val; calc();
    });
  };
  brancher("sel-etat", etat);
  brancher("sel-capacite", capacite);

  const tg = document.getElementById("batt-toggle");
  tg.addEventListener("click", () => {
    batterie.on = !batterie.on;
    tg.classList.toggle("on", batterie.on);
    tg.setAttribute("aria-checked", batterie.on);
    calc();
  });

  document.querySelectorAll(".vignettes button").forEach(b => b.addEventListener("click", () => {
    document.querySelectorAll(".vignettes button").forEach(x=>x.classList.remove("active"));
    b.classList.add("active");
    document.getElementById("g-principal").innerHTML = telSVG(b.dataset.coul, 1.4);
  }));

  document.getElementById("btn-panier").addEventListener("click", () => {
    ajouterAuPanier(`iPhone 13 ${capacite.v} · ${etat.v}${batterie.on?" · batterie neuve":""}`,
                    etat.v==="Parfait état"?439:etat.v==="État correct"?339:379 + PRIX_BASE.capacite[capacite.v] + (batterie.on?39:0));
  });

  calc();
}

function initReprise(){
  document.getElementById("offre-choix").addEventListener("click", e => {
    const b = e.target.closest(".offre-opt"); if(!b) return;
    document.querySelectorAll(".offre-opt").forEach(x=>x.classList.remove("active"));
    b.classList.add("active");
    document.getElementById("offre-montant").textContent = b.dataset.total + " €";
  });
  document.getElementById("btn-accepter").addEventListener("click", () => {
    document.getElementById("offre-confirm").style.display = "block";
  });
}

/* ============ Render ============ */
function render(page="accueil", arg){
  const app = document.getElementById("app");
  app.innerHTML = routes[page] ? routes[page](arg) : routes.accueil();
  if(page==="produit") initProduit();
  if(page==="reprise") initReprise();
}

/* Recherche → fiche produit (démo) */
document.getElementById("q").addEventListener("keydown", e => {
  if(e.key!=="Enter") return;
  const v = e.target.value.toLowerCase();
  if(v.includes("s23")||v.includes("samsung")) render("produit","galaxy23");
  else if(v.includes("pixel")) render("produit","pixel8");
  else render("produit","iphone13");
  window.scrollTo(0,0);
});

/* Bouton "Voir les offres" du finder → best-sellers */
document.addEventListener("click", e => {
  if(e.target.id==="f-go"){
    document.getElementById("best")?.scrollIntoView({behavior:"smooth"});
  }
});

